# Copy to .env in the pcbforge folder: pcbforge reads it on startup (variables already set win).
ANTHROPIC_API_KEY=
# Only needed if `java -version` is older than 25:
# JAVA=/usr/lib/jvm/java-25-openjdk-amd64/bin/java
# Override if KiCad is installed somewhere non-standard:
# KICAD_SHARE=/usr/share/kicad
# FREEROUTING_JAR=tools/freerouting.jar
# SKIDL_TOOL=KICAD9
# JLCPCB parts check: your own API key for the Parts endpoints, created at api.jlcpcb.com
# (Console > Manage Apps > your app > Access Key > Create). See docs/jlcpcb_api.md.
# JLC_APP_ID=
# JLC_ACCESS_KEY=
# JLC_SECRET_KEY=
# JLC_API_BASE=https://open.jlcpcb.com
